# 업무 녹음 자동화 시스템 설정 예시
# 실제 값은 시크릿 관리 도구나 배포 환경의 비밀 변수로 주입하세요.
# 이 파일을 `.env`로 복사해 쓰되, `.env`는 절대 커밋하지 마세요.

# ── 업무일·스케줄 ───────────────────────────────────────────────
TIMEZONE=Asia/Seoul
# 업무일 경계 시각. 0이면 자정 기준. 4로 두면 새벽 4시 이전 녹음은 전날 업무로 묶인다.
BUSINESS_DAY_CUTOFF_HOUR=0
# 정기 실행 시각(HH:MM, TIMEZONE 기준). 자정 정각은 마지막 청크 업로드가
# 끝나지 않았을 수 있어 5~15분 여유를 둔다.
DAILY_SUMMARY_TIME=00:05

# ── 저장 위치 ───────────────────────────────────────────────────
WORK_RECORDER_HOME=~/.work-recorder
# DATABASE_PATH=~/.work-recorder/work-recorder.db
# WORK_DIR=~/.work-recorder/work
# 다운로드한 오디오를 처리 후에도 남길지 (기본 false)
KEEP_DOWNLOADS=false

# ── 어댑터 선택 ─────────────────────────────────────────────────
# local | google_drive
SOURCE_ADAPTER=local
# mock | openai_compatible
STT_ADAPTER=mock
# mock | claude
ANALYZER_ADAPTER=mock
# console, notion, slack (쉼표로 여러 개)
PUBLISHERS=console

# ── 로컬 저장소 ─────────────────────────────────────────────────
LOCAL_SOURCE_DIR=~/업무녹음

# ── Google Drive ────────────────────────────────────────────────
GOOGLE_DRIVE_RECORDINGS_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID
GOOGLE_OAUTH_CREDENTIALS_PATH=/secure/path/credentials.json
GOOGLE_OAUTH_TOKEN_PATH=/secure/path/token.json

# ── STT (OpenAI 호환 /audio/transcriptions) ─────────────────────
# OpenAI, Groq, 로컬 whisper 서버 등 같은 규격이면 BASE_URL만 바꾸면 된다.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=YOUR_STT_API_KEY
STT_MODEL=whisper-1
STT_LANGUAGE=ko
STT_TIMEOUT_SECONDS=600

# ── LLM 분석 (Anthropic Claude) ─────────────────────────────────
# 비워 두면 SDK가 환경 변수나 `ant auth login` 프로필을 찾는다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_MAX_TOKENS=16000
# 정책 거절 시 서버측 폴백 모델로 자동 재시도
LLM_ENABLE_FALLBACKS=true
# 하루치 전사가 이보다 길면 뒷부분을 잘라서 분석한다(원문은 그대로 보관).
MAX_TRANSCRIPT_CHARS=200000
# 프롬프트를 파일로 덮어쓰고 싶을 때
# WORK_RECORDER_PROMPT_FILE=~/.work-recorder/prompt.txt

# ── Notion ──────────────────────────────────────────────────────
NOTION_TOKEN=YOUR_NOTION_INTEGRATION_TOKEN
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID
# 새 Notion API(2025-09-03)의 data source를 쓸 경우 이쪽을 채운다.
NOTION_DATA_SOURCE_ID=
# DB 속성 이름이 다르면 매핑을 덮어쓴다.
# NOTION_PROPERTY_MAP={"title":"제목","status":"상태","summary":"회의 요약","todos":"할일 목록","transcript":"원본 텍스트","recording_link":"녹음 파일","date":"녹음 날짜"}

# ── Slack ───────────────────────────────────────────────────────
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
# DM으로 받으려면 본인 사용자 ID(U...) 또는 DM 채널 ID(D...)
SLACK_CHANNEL_ID=YOUR_SLACK_DM_CHANNEL_ID

# ── 작업 API (수동 정리 요청) ───────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8787
# Mac 앱이 Authorization: Bearer <값> 으로 보낸다. 반드시 설정하세요.
API_TOKEN=CHANGE_ME
API_BASE_URL=http://127.0.0.1:8787

# ── 처리 정책 ───────────────────────────────────────────────────
MAX_RETRY_COUNT=3
WORKER_POLL_SECONDS=5
